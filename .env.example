# ==============================================================================
#  Salon Agent Dashboard — نموذج المتغيّرات البيئية (.env.example)
#  انسخ هذا الملف إلى .env.local للتطوير، وأضف نفس القيم في Vercel للإنتاج.
#  cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase  (مطلوب — بدونه لن تُحفظ أو تظهر أي مواقع/عملاء)
# NEXT_PUBLIC_SUPABASE_URL: رابط مشروع Supabase (https://xxxx.supabase.co)
# استخدم SUPABASE_SECRET_KEY الجديد (يبدأ بـ sb_secret_) أو مفتاح service_role القديم.
# يكفي واحد منهما، والأفضل الجديد.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_new_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt_optional

# ------------------------------------------------------------------------------
# Google Places API  (مطلوب — هذا سبب "ما تطلع المواقع" إذا كان فارغ)
# فعّل Places API (New) في Google Cloud ثم أنشئ مفتاح API.
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ------------------------------------------------------------------------------
# OpenAI  (اختياري — لتوليد نصوص/حملات أفضل. بدونه يشتغل بنص احتياطي fallback)
# OPENAI_MODEL: اتركه فارغًا للافتراضي، أو مثلاً gpt-4o-mini
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=

# ------------------------------------------------------------------------------
# حماية لوحة التحكم /dashboard  (Basic Auth — مطلوب في الإنتاج)
# ------------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me_to_a_strong_password

# ------------------------------------------------------------------------------
# أسرار التطبيق
# PREVIEW_TOKEN_SECRET: سلسلة عشوائية طويلة لتوقيع روابط المعاينة.
# CRON_SECRET: سلسلة عشوائية لحماية مهمّة الاكتشاف اليومي /api/cron/daily-discovery.
#   ولّدها بأمر: openssl rand -hex 32
# ------------------------------------------------------------------------------
PREVIEW_TOKEN_SECRET=generate_with_openssl_rand_hex_32
CRON_SECRET=generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# عنوان التطبيق العام (يُستخدم في بناء روابط المعاينة والمشاركة)
# محليًا: http://localhost:3000  — في الإنتاج: رابط دومينك.
# على Vercel يتم استنتاجه تلقائيًا من VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
